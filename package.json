{
  "name": "math-scratchpad-redux",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "vitest run tests/unit tests/store.test.ts tests/assessment.test.ts tests/legacy.test.ts tests/wide/layout-model.test.ts",
    "test:integration": "vitest run tests/integration tests/app.test.tsx tests/fraction-round.test.tsx tests/keyboard-ux.test.tsx tests/wide/workspace.test.tsx tests/integration/tutor-export-ui.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run tests/accessibility",
    "test:ux": "vitest run tests/ux",
    "test:a11y:browser": "playwright test e2e/accessibility",
    "test:sync": "playwright test e2e/persistence",
    "test:visual": "playwright test e2e/visual",
    "test:gate": "node scripts/test-gate.mjs",
    "test:manual-gate": "node scripts/test-manual-gate.mjs",
    "test:release": "npm run test:gate && npm run test:manual-gate",
    "test:property": "vitest run tests/properties",
    "test:architecture": "vitest run tests/architecture",
    "test:browser:prepare": "node scripts/prepare-browser.mjs",
    "test:wide": "vitest run tests/wide",
    "test:wide:browser": "playwright test --project=laptop-1024 --project=laptop-1440 --project=desktop-1920 --project=desktop-2560"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^11.2.9",
    "lucide-react": "^1.63.0",
    "mathlive": "0.111.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.0",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  }
}
